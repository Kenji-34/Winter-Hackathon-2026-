# Supabase — safe to expose in client bundle (Vite inlines VITE_* vars)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY (used in api/ functions, no VITE_ prefix)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini — SERVER ONLY. Never prefix with VITE_; never import inside src/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
